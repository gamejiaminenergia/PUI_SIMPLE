# Configuración de entorno para PUI_SIMPLE
# Copia este archivo a .env y ajusta los valores

# Base de Datos PostgreSQL (opcional - si no se usa, genera datos mock)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elecdb
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración del modelo TimesFM (opcional)
# TIMESFM_MODEL=google/timesfm-1.0-200m
# TIMESFM_BACKEND=cpu

# Configuración de salida
OUTPUT_DIR=output