<div class="chart full"><img src="{{ assets.ranking }}"><div class="caption">Figura 3. Ranking completo de los {{ market.n }} agentes por sobrecosto acumulado (★ = Asociado ACCE).</div></div>

<table class="data">
    <thead><tr><th>#</th><th>Código</th><th>Nombre</th><th>Rol</th><th class="num">Sobrecosto</th><th class="num">Flujo neto</th><th class="num">Pérdida %</th><th>ACCE</th></tr></thead>
